# ==============================================================
# PoshanSaathi Environment Configuration Example
# Copy this file to .env and replace placeholder values.
# NEVER commit your real secrets to version control.
# ==============================================================

# Resend Email API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Email Address
# Note: For free Resend test accounts, use "PoshanSaathi <onboarding@resend.dev>"
# For production domains, use "PoshanSaathi <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=PoshanSaathi <onboarding@resend.dev>

# Port for web service (Render dynamically sets $PORT in production)
PORT=8000

# SQLite Database File Path (Optional, defaults to poshan_saathi.db)
DB_PATH=poshan_saathi.db

# Secret key for session token signing (Replace with a strong random string in production)
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# Public base URL for Password Reset Link sent in email
# e.g., https://poshan-saathi-1.onrender.com/api/auth/reset-password
# When empty or omitted, defaults to backend host endpoint /api/auth/reset-password
PASSWORD_RESET_URL=https://your-backend-app.onrender.com/api/auth/reset-password

